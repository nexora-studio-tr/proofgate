{
  "name": "proofgate",
  "version": "0.1.0-alpha.3",
  "private": true,
  "type": "module",
  "description": "Before/after verification and mutation evidence for agent-authored changes",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "proofgate": "dist/apps/cli/src/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages tests scripts plugins *.json *.ts",
    "format:check": "prettier --check apps packages tests scripts plugins *.json *.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/apps/cli/src/index.js serve",
    "setup": "node scripts/setup.mjs",
    "demo": "node dist/apps/cli/src/index.js demo",
    "test:docker": "node scripts/validate-docker.mjs",
    "test:browser": "node scripts/validate-browser.mjs",
    "test:team-browser": "node scripts/validate-team-browser.mjs",
    "test:isolation": "node scripts/validate-isolation.mjs",
    "test:deployment": "node scripts/validate-deployment.mjs",
    "test:integration": "node scripts/validate-integration.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:pack": "node scripts/release.mjs",
    "test:release": "node scripts/validate-release.mjs",
    "test:workspace": "node scripts/validate-workspace.mjs",
    "test:workspace-execution": "node scripts/validate-workspace-execution.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.7",
    "@modelcontextprotocol/server": "2.4.0",
    "fastify": "5.12.7",
    "get-nonce": "1.0.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "qs": "6.16.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@stryker-mutator/instrumenter": "10.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "prettier": "3.9.10"
  }
}
